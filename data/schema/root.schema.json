{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wubi-learning.example/schema/root.schema.json",
  "title": "Wubi 86 root",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "glyph",
    "key",
    "area",
    "position",
    "category",
    "sourceIds",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^root-[a-z0-9-]+$"
    },
    "version": {
      "const": "86"
    },
    "glyph": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8
    },
    "variants": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Y]$"
    },
    "area": {
      "enum": [
        "horizontal",
        "vertical",
        "撇",
        "捺",
        "折"
      ]
    },
    "position": {
      "type": "string",
      "pattern": "^[1-5][1-5]$"
    },
    "category": {
      "enum": [
        "ordinary",
        "key_name",
        "character_root"
      ]
    },
    "mnemonicText": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^S[0-9]{3,}$"
      }
    },
    "verification": {
      "$ref": "#/$defs/verification"
    }
  },
  "$defs": {
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "needs_review",
            "verified",
            "rejected"
          ]
        },
        "reviewedBy": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
